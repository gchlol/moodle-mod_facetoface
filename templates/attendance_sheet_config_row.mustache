{{!
    @template mod_facetoface/attendance_sheet_row

    This template will render a row of the attendance sheet table.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-attendance-sheet-item
    * data-attendance-remove-row
    * data-value
    * data-attendance-sheet-config-remove-row
    * data-remove-value

    Context variables required for this template:
    * id - ID of the item being displayed.
    * labels - Array of label objects, each containing a 'value', and possibly 'first' to indicate the drag handle.
    * first - If the table cell is in the first column, it needs to be draggable to move the whole row.
    * value - Text displayed in the table's current cell.

    Example context (json):
    {
        'id'     => 0,
        'labels' => {
            {
                'value' => 'Name', // "Name" in the first column
                'first' => true    // indicates we include the hidden input + drag handle
            },
            {
                'value' => ''      // second column is empty by default
            }
        }
    }
}}

<tr data-attendance-sheet-config-item data-value="{{id}}" {{#editable}}data-changeable="{{type}}"{{/editable}}>
    <td>
        {{#editable}}
            <input name="item_ids[]" type="hidden" value="{{id}}" />
            {{> core/drag_handle}}
            <input type="text" name="column_names[]" value="{{labels.0.value}}" />
        {{/editable}}
        {{^editable}}
            {{#labels}}
                {{#first}}
                    <input name="item_ids[]" type="hidden" value="{{../id}}" />
                    {{> core/drag_handle}}
                    {{value}}
                {{/first}}
            {{/labels}}
        {{/editable}}
    </td>
    <td>
        {{^editable}}
            {{#labels}}
                {{^first}}
                    {{value}}
                {{/first}}
            {{/labels}}
        {{/editable}}
        {{#editable}}
            <input type="text" name="header_values[]" value="{{defaultvalue}}" />
        {{/editable}}
    </td>
    <td class="action-column">
        <a href="#" data-attendance-sheet-config-remove-row data-remove-value="{{id}}">
            {{#pix}} t/delete, core, {{#str}}modform:removerow, mod_facetoface{{/str}} {{/pix}}
        </a>
    </td>
</tr>