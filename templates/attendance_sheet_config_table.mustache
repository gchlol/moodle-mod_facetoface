{{!
    @template mod_facetoface/attendance_sheet_table

    This template will render a table used to configure attendance sheet items.

    Classes required for JS:
    * none

    Data attributes required for JS:
    * data-attendance-sheet-table
    * data-attendance-items
    * data-table-header
    *

    Context variables required for this template:
    * uniqid               - a unique ID for the table container
    * header_text_column   - the text label for the first column heading
    * header_text_value    - the text label for the second column heading
    * empty_table          - boolean indicating if no attendance items exist
    * attendance_items     - array of attendance item data to display in the table

    Additional details:
    * The third column in the table header originally contained a dropdown for adding new items.
    * Each row in the table body is rendered using the partial: mod_facetoface/attendance_sheet_config_row

    Example context (json):
    {
        {
            'id'     => 0,
            'labels' => {
                {
                    'value' => 'Name', // "Name" in the first column
                    'first' => true    // indicates we include the hidden input + drag handle
                },
                {
                    'value' => ''      // second column is empty by default
                }
            }
        },
        {
            'id'     => 1,
            'labels' => {
                {
                    'value' => 'Pass/Fail', // "Pass/Fail" in the first column
                    'first' => true
                },
                {
                    'value' => 'Pass/Fail'  // second column has "Pass/Fail"
                }
            }
        }
    };
}}

<link rel="stylesheet" type="text/css" href="{{{wwwroot}}}/mod/facetoface/style/attendance_sheet_config_styles.css">
    <div>
        <!-- Hidden input to store the JSON configuration data before form submission -->
        <input type="hidden" name="config_data" id="config_data" value="">
        <table class="attendance-sheet-config__table w-100 table-sm table-hover generaltable" data-attendance-sheet-config-table>
            <thead>
            <tr>
                <th data-table-header>{{header_text_column}}</th>
                <th data-table-header colspan="2">
                    <div class="attendance-sheet-config__default-value-header">
                        <span>{{header_text_value}}</span>
                        <select data-attendance-sheet-config-add-row class="custom-select attendance-sheet-config__dropdown-add-item">
                            <option value="" hidden>
                                {{#str}}additem, mod_facetoface{{/str}}
                            </option>
                            <option value="Name">{{#str}}attendancecolumn:0, mod_facetoface{{/str}}</option>
                            <option value="Payroll">{{#str}}attendancecolumn:1, mod_facetoface{{/str}}</option>
                            <option value="Email">{{#str}}attendancecolumn:2, mod_facetoface{{/str}}</option>
                            <option value="Org Unit">{{#str}}attendancecolumn:3, mod_facetoface{{/str}}</option>
                            <option value="Position">{{#str}}attendancecolumn:4, mod_facetoface{{/str}}</option>
                            <option value="Stream">{{#str}}attendancecolumn:5, mod_facetoface{{/str}}</option>
                            <option value="Paypoint">{{#str}}attendancecolumn:6, mod_facetoface{{/str}}</option>
                            <option value="Custom Column">{{#str}}attendancecolumn:customcolumn, mod_facetoface{{/str}}</option>
                        </select>
                    </div>
                </th>
            </tr>
            </thead>

            <tbody data-attendance-sheet-config-items>
            <!-- "Empty" row displayed if no items exist -->
            <tr class="empty" {{^empty_table}}hidden{{/empty_table}}>
                <td colspan="3">
                    {{#str}}modform:emptytext, mod_facetoface{{/str}}
                </td>
            </tr>

            <!-- Render existing rows from attendance_items -->
            {{#attendance_items}}
                {{> mod_facetoface/attendance_sheet_config_row}}
            {{/attendance_items}}
            </tbody>
        </table>
        <!-- Save Config and Cancel buttons -->
        <div class="attendance-sheet-config__button-container mt-3">
            <button type="submit" id="save-config" class="attendance-sheet-config__button attendance-sheet-config__button--save">Save Config</button>
            <button type="button" id="cancel-config" class="attendance-sheet-config__button attendance-sheet-config__button--cancel">Cancel</button>
        </div>

</div>
